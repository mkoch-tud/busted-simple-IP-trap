# The public DNS name whose A/AAAA record points to this Docker host.
SERVER_DOMAIN=trap.example.com

# Let's Encrypt expiration and account notices are sent here.
CERTBOT_EMAIL=admin@example.com

# Use true while testing to avoid Let's Encrypt production rate limits.
CERTBOT_STAGING=false

# letsencrypt, tu-dresden, or custom
CERTBOT_CA=letsencrypt
CERTBOT_SERVER_URL=
CERTBOT_CERT_NAME=

# Check twice daily; retry failures after five minutes.
CERTBOT_RENEW_INTERVAL=43200
CERTBOT_RETRY_INTERVAL=300

# Persistent visitor, processed, and nonce files.
LOGFILES_DIR=./logfiles

# Length of generated alphanumeric tracking nonces (minimum 8).
NONCE_LENGTH=24
